# Copy to .env and fill in. .env is gitignored.

# Sanity project to write into (same project/dataset as the Studio).
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production

# Write-enabled API token (Sanity: Manage -> API -> Tokens, "Editor" or higher).
# Only needed for a real `pnpm migrate` run; the dry run does not use it.
SANITY_WRITE_TOKEN=

# Optional override for the Contentful export file. Defaults to the export under
# ../../Contentful/exports/ if left unset.
CONTENTFUL_EXPORT=
